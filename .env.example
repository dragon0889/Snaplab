# Copy to .env on the server (never commit .env). All values are server-side only: never prefix with NEXT_PUBLIC_.

# Public domain that points (A/AAAA record) at the VPS. Caddy gets the HTTPS certificate for it.
DOMAIN=snaplab.example.com

# Closed-beta invite code (8+ characters). Visitors must type it once; leave empty only on a local dev machine.
BETA_ACCESS_CODE=

# Claude API key for the AI tutor. Without it the tutor answers with built-in rule-based hints.
ANTHROPIC_API_KEY=
# Optional: override the tutor model (default claude-haiku-5-5)
TUTOR_MODEL=
# Optional: maximum AI replies per UTC day before falling back to free hints (default 500)
TUTOR_DAILY_AI_CAP=500
